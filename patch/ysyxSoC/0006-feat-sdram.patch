diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index c0d20764..fa870c35 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -23,7 +23,67 @@ module apb_delayer(
   input  [31:0] out_prdata,
   input         out_pslverr
 );
+`ifdef CONFIG_APB_DELAY
+  parameter S = 32768,// 2^15
+            R = 7,
+            R_mul_S = S * R; // 2^15 * 7.22
+  parameter IDLE = 0,
+            WAIT = 1,
+            PROC = 2,
+            READY = 3;
+reg [1:0]   state;
+reg [31:0]  delay_cnt;
+reg         out_pready_r;
+reg         out_pslverr_r;
+reg [31:0]  out_prdata_r;
+
+always @(posedge clock) begin
+  if(reset) begin
+    state <= IDLE;
+    delay_cnt <= 0;
+  end else begin
+    case(state)
+      IDLE: begin
+        if(in_psel && in_penable) begin
+          state <= WAIT;
+          delay_cnt <= 0;
+        end
+      end
+      WAIT: begin
+        delay_cnt <= delay_cnt + R_mul_S;
+        if(out_pready) begin
+          delay_cnt <= (delay_cnt >> 15); // 除以2^15
+          out_pready_r <= out_pready;
+          out_pslverr_r <= out_pslverr;
+          out_prdata_r <= out_prdata;
+          state <= PROC;
+        end
+      end
+      PROC: begin
+        if(delay_cnt == 0) begin
+          state <= READY;
+        end else begin
+          delay_cnt <= delay_cnt - 1;
+        end
+      end
+      READY: begin
+        state <= IDLE;
+      end
+  endcase
+  end
+end
 
+  assign out_paddr   = in_paddr;
+  assign out_psel    = in_psel;
+  assign out_penable = in_penable;
+  assign out_pprot   = in_pprot;
+  assign out_pwrite  = in_pwrite;
+  assign out_pwdata  = in_pwdata;
+  assign out_pstrb   = in_pstrb;
+  assign in_pready   = (state == READY) ? out_pready_r : 1'b0;
+  assign in_prdata   = (state == READY) ? out_prdata_r : 32'b0;
+  assign in_pslverr  = (state == READY) ? out_pslverr_r : 1'b0;
+`else 
   assign out_paddr   = in_paddr;
   assign out_psel    = in_psel;
   assign out_penable = in_penable;
@@ -34,5 +94,5 @@ module apb_delayer(
   assign in_pready   = out_pready;
   assign in_prdata   = out_prdata;
   assign in_pslverr  = out_pslverr;
-
+`endif 
 endmodule
diff --git a/perip/amba/axi4_delayer.v b/perip/amba/axi4_delayer.v
index f692803b..e3a56ec3 100644
--- a/perip/amba/axi4_delayer.v
+++ b/perip/amba/axi4_delayer.v
@@ -63,6 +63,12 @@ module axi4_delayer(
   input  [1:0]  out_bresp
 );
 
+  parameter DELAY_RATIO = 7;
+  parameter S = 32768;
+  parameter R_MUL_S = DELAY_RATIO * S;
+
+
+  // Address channels (no delay)
   assign in_arready = out_arready;
   assign out_arvalid = in_arvalid;
   assign out_arid = in_arid;
@@ -70,12 +76,7 @@ module axi4_delayer(
   assign out_arlen = in_arlen;
   assign out_arsize = in_arsize;
   assign out_arburst = in_arburst;
-  assign out_rready = in_rready;
-  assign in_rvalid = out_rvalid;
-  assign in_rid = out_rid;
-  assign in_rdata = out_rdata;
-  assign in_rresp = out_rresp;
-  assign in_rlast = out_rlast;
+
   assign in_awready = out_awready;
   assign out_awvalid = in_awvalid;
   assign out_awid = in_awid;
@@ -83,14 +84,109 @@ module axi4_delayer(
   assign out_awlen = in_awlen;
   assign out_awsize = in_awsize;
   assign out_awburst = in_awburst;
+
+  // Write data channel (no delay for now)
   assign in_wready = out_wready;
   assign out_wvalid = in_wvalid;
   assign out_wdata = in_wdata;
   assign out_wstrb = in_wstrb;
   assign out_wlast = in_wlast;
+
+  assign out_rready = in_rready;
+
   assign out_bready = in_bready;
+
+`ifdef CONFIG_AXI_DELAY
+  parameter IDLE = 0, R_WAIT = 1, R_PROC = 2, R_READY = 3,
+                      W_WAIT = 1, W_PROC = 2, W_READY = 3;
+
+  reg [1 : 0] r_state;
+  reg [1 : 0] w_state;
+  reg [31: 0] r_delay_cnt;
+  reg [31: 0] w_delay_cnt;
+  reg         r_rvalid;
+  reg [31: 0] r_data;
+  reg [1 : 0] r_rresp;
+  reg [3 : 0] r_rid;
+  reg         r_last;
+  reg         w_bvalid;
+  reg [3 : 0] w_bid;
+  reg [1 : 0] w_bresp;
+  always @(posedge clock) begin
+    if(reset) begin
+      r_state <= IDLE;
+      w_state <= IDLE;
+      r_delay_cnt <= 0;
+      w_delay_cnt <= 0;
+    end
+    case(r_state)
+      IDLE : begin
+        if(in_arvalid && out_arready) begin
+           r_delay_cnt <= R_MUL_S;
+           r_state <= R_WAIT;
+        end
+      end
+      R_WAIT : begin
+        r_delay_cnt <= r_delay_cnt + R_MUL_S;
+        if(out_rvalid) begin
+          r_delay_cnt <= r_delay_cnt >> 15;
+          r_rvalid <= out_rvalid;
+          r_last <= out_rlast;
+          r_data <= out_rdata;
+          r_rid  <= out_rid;
+          r_rresp<= out_rresp;
+          r_state <= R_PROC;
+        end
+      end
+      R_PROC : begin
+        if(r_delay_cnt == 0) r_state <= R_READY;
+        else r_delay_cnt <= r_delay_cnt - 1;
+      end
+      R_READY : begin
+        r_state <= IDLE;
+      end
+    endcase
+    case(w_state)
+      IDLE : begin
+        if(in_awvalid && out_awready) begin
+           w_delay_cnt <= R_MUL_S;
+           w_state <= W_WAIT;
+        end
+      end
+      W_WAIT : begin
+        w_delay_cnt <= w_delay_cnt + R_MUL_S;
+        if(out_bvalid) begin
+          w_delay_cnt <= w_delay_cnt >> 15;
+          w_bvalid <= out_bvalid;
+          w_bresp <= out_bresp;
+          w_bid <= out_bid;
+          w_state <= W_PROC;
+        end
+      end
+      W_PROC : begin
+        if(w_delay_cnt == 0) w_state <= W_READY;
+        else w_delay_cnt <= w_delay_cnt - 1;
+      end
+      W_READY : w_state <= IDLE;
+    endcase
+  end
+  assign in_rvalid = (r_state == R_READY) ? r_rvalid : 0;
+  assign in_rdata = (r_state == R_READY) ? r_data : 0;
+  assign in_rresp = (r_state == R_READY) ? r_rresp : 0;
+  assign in_rid = (r_state == R_READY) ? r_rid : 0;
+  assign in_rlast = (r_state == R_READY) ? r_last : 0;
+  assign in_bvalid = (w_state == W_READY) ? w_bvalid : 0;
+  assign in_bresp = (w_state == W_READY) ? w_bresp : 0;
+  assign in_bid = (w_state == W_READY) ? w_bid : 0;
+`else  
+  assign in_rvalid = out_rvalid;
+  assign in_rdata = out_rdata;
+  assign in_rresp = out_rresp;
+  assign in_rid = out_rid;
+  assign in_rlast = out_rlast;
+  
   assign in_bvalid = out_bvalid;
   assign in_bid = out_bid;
   assign in_bresp = out_bresp;
-
+`endif 
 endmodule
