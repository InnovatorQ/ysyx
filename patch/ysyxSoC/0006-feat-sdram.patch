     end
     //-----------------------------------------
     // STATE_PRECHARGE
@@ -594,6 +597,7 @@ begin
         command_q   <= CMD_REFRESH;
         addr_q      <= {SDRAM_ROW_W{1'b0}};
         bank_q      <= {SDRAM_BANK_W{1'b0}};
+        cs          <= 1'b0;
     end
     //-----------------------------------------
     // STATE_READ
@@ -709,8 +713,8 @@ assign sdram_data_in_w       = sdram_data_input_i;
 
 assign sdram_cke_o  = cke_q;
 // Generate chip selects for word expansion
-assign sdram_cs_o[0] = (command_q[3] & ~addr_cs_w) | addr_cs_w;  // Lower 32-bit word
-assign sdram_cs_o[1] = (command_q[3] & addr_cs_w) | ~addr_cs_w;   // Upper 32-bit word
+assign sdram_cs_o[0] = (command_q[3] & ~cs) | cs;  // Lower 32-bit word
+assign sdram_cs_o[1] = (command_q[3] & cs) | ~cs;   // Upper 32-bit word
 assign sdram_ras_o  = command_q[2];
 assign sdram_cas_o  = command_q[1];
