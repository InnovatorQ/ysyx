diff --git a/perip/sdram/sdram_quad.v b/perip/sdram/sdram_quad.v
new file mode 100644
index 00000000..830dd75f
--- /dev/null
+++ b/perip/sdram/sdram_quad.v
@@ -0,0 +1,72 @@
+// SDRAM Word Expansion Module
+// 2 pairs of SDRAM chips: bit expansion within pairs, word expansion between pairs
+// Total capacity: 2 x 32MB = 64MB
+
+module sdram_quad(
+  input        clk,
+  input        cke,
+  input [1:0]  cs,      // 2 chip selects for word expansion
+  input        ras,
+  input        cas,
+  input        we,
+  input [12:0] a,
+  input [1:0]  ba,
+  input [3:0]  dqm,     // 4-bit DQM for 32-bit data
+  inout [31:0] dq       // 32-bit data bus
+);
+
+  // First pair (cs[0]) - bit expansion for first 32MB
+  sdram sdram0 (
+    .clk(clk),
+    .cke(cke),
+    .cs(cs[0]),
+    .ras(ras),
+    .cas(cas),
+    .we(we),
+    .a(a),
+    .ba(ba),
+    .dqm(dqm[1:0]),     // DQM for lower 16 bits
+    .dq(dq[15:0])       // Lower 16 bits
+  );
+
+  sdram sdram1 (
+    .clk(clk),
+    .cke(cke),
+    .cs(cs[0]),
+    .ras(ras),
+    .cas(cas),
+    .we(we),
+    .a(a),
+    .ba(ba),
+    .dqm(dqm[3:2]),     // DQM for upper 16 bits
+    .dq(dq[31:16])      // Upper 16 bits
+  );
+
+  // Second pair (cs[1]) - bit expansion for second 32MB
+  sdram sdram2 (
+    .clk(clk),
+    .cke(cke),
+    .cs(cs[1]),
+    .ras(ras),
+    .cas(cas),
+    .we(we),
+    .a(a),
+    .ba(ba),
+    .dqm(dqm[1:0]),     // DQM for lower 16 bits
+    .dq(dq[15:0])       // Lower 16 bits (shared bus)
+  );
+
+  sdram sdram3 (
+    .clk(clk),
+    .cke(cke),
+    .cs(cs[1]),
+    .ras(ras),
+    .cas(cas),
+    .we(we),
+    .a(a),
+    .ba(ba),
+    .dqm(dqm[3:2]),     // DQM for upper 16 bits
+    .dq(dq[31:16])      // Upper 16 bits (shared bus)
+  );
+
+endmodule
